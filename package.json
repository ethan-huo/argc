{
	"name": "argc",
	"version": "7.9.0",
	"type": "module",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./src/index.ts",
			"default": "./src/index.ts"
		},
		"./terminal": {
			"types": "./dist/terminal.d.ts",
			"import": "./src/terminal.ts",
			"default": "./src/terminal.ts"
		},
		"./skill": {
			"types": "./dist/skill.d.ts",
			"import": "./src/skill.ts",
			"default": "./src/skill.ts"
		}
	},
	"scripts": {
		"build": "tsc -p tsconfig.build.json",
		"build:analyze": "bun build src/index.ts --outfile=dist/argc.js --target=bun --minify --metafile-md=dist/metafile.md",
		"check": "bun run --parallel --no-exit-on-error fmt:check typecheck test",
		"test": "bun test --parallel",
		"test:changed": "bun test --changed",
		"typecheck": "tsc --noEmit",
		"fmt": "oxfmt",
		"fmt:check": "oxfmt --check"
	},
	"dependencies": {
		"oxc-parser": "0.137.0",
		"yaml": "2.9.0"
	},
	"devDependencies": {
		"@types/bun": "^1.4.0",
		"@valibot/to-json-schema": "^1.7.1",
		"oxfmt": "^0.56.0",
		"typescript": "^7.0.2",
		"valibot": "^1.4.1"
	},
	"peerDependencies": {
		"@standard-schema/spec": "^1.0.0"
	},
	"engines": {
		"bun": ">=1.4.0"
	}
}
